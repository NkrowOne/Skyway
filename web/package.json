{
  "name": "@skyway/web",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run check:classes",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "vitest run",
    "preview": "vite preview",
    "logos": "node scripts/fetch-logos.mjs",
    "check:classes": "node scripts/check-classes.mjs \"$(ls dist/assets/*.css | head -1)\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.33",
    "simple-icons": "^16.38.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
