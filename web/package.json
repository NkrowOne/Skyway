{
  "name": "@skyway/web",
  "version": "0.38.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run check:classes",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "vitest run",
    "preview": "vite preview",
    "logos": "node scripts/fetch-logos.mjs",
    "check:classes": "node scripts/check-classes.mjs \"$(ls dist/assets/*.css | head -1)\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.23",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.41",
    "simple-icons": "^16.27.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
