# Puerto del servidor de Skyway
PORT=4000

# Directorio de datos (SQLite, builds, logs)
DATA_DIR=./data

# Secreto para firmar sesiones (si no se define, se genera y persiste automáticamente)
# JWT_SECRET=cambia-esto

# Confianza en cabeceras de proxy (X-Forwarded-For/-Proto) para la IP real del
# cliente (límite anti fuerza bruta y auditoría). Por defecto solo se confía en
# proxies de rango privado/loopback (Traefik, túnel SSH). Valores: true, false,
# un número de saltos, o una lista de CIDRs separada por comas.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Builds simultáneos. Por defecto, núcleos del servidor menos uno, acotado a
# [2, 4]: deja margen para el propio panel y los servicios en marcha.
# BUILD_CONCURRENCY=2

# Dominio donde servir la propia UI de Skyway a través de Traefik (docker-compose).
# Un solo nombre: va tal cual en la regla Host() del panel.
SKYWAY_DOMAIN=skyway.localhost

# Nombres adicionales del panel, separados por comas (opcional). Útil al cambiar
# de dominio: el anterior sigue sirviendo el panel mientras tanto.
# SKYWAY_DOMAIN_EXTRA=panel-anterior.midominio.com

# Correo para los certificados de Let's Encrypt. NECESARIO para TLS: sin un
# correo real (ni vacío ni de example.com, que Let's Encrypt rechaza) no se emite
# ningún certificado. Tras cambiarlo: docker compose up -d traefik
LETSENCRYPT_EMAIL=
