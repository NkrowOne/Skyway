# Puerto del servidor de Skyway
PORT=4000

# Directorio de datos (SQLite, builds, logs)
DATA_DIR=./data

# Secreto para firmar sesiones (si no se define, se genera y persiste automáticamente)
# JWT_SECRET=cambia-esto

# Confianza en cabeceras de proxy (X-Forwarded-For/-Proto) para la IP real del
# cliente (límite anti fuerza bruta y auditoría). Por defecto solo se confía en
# proxies de rango privado/loopback (Traefik, túnel SSH). Valores: true, false,
# un número de saltos, o una lista de CIDRs separada por comas.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Builds simultáneos. Por defecto, núcleos del servidor menos uno, acotado a
# [2, 4]: deja margen para el propio panel y los servicios en marcha.
# BUILD_CONCURRENCY=2

# Dominio donde servir la propia UI de Skyway a través de Traefik (docker-compose).
# Un solo nombre: va tal cual en la regla Host() del panel.
SKYWAY_DOMAIN=skyway.localhost

# Nombres adicionales del panel, separados por comas (opcional). Útil al cambiar
# de dominio: el anterior sigue sirviendo el panel mientras tanto.
# SKYWAY_DOMAIN_EXTRA=panel-anterior.midominio.com

# Correo de contacto para Let's Encrypt (recomendado). Vacío, la cuenta se
# registra sin contacto y los certificados se emiten igual; uno de ejemplo
# (example.com, .test, .local…) hace que Let's Encrypt la rechace y no se emite
# ningún certificado. Tras cambiarlo: docker compose up -d traefik
LETSENCRYPT_EMAIL=

# Certificado comodín del dominio raíz (opcional). Con este token de API de
# Cloudflare, Traefik pide por DNS-01 UN certificado para el dominio raíz de
# Ajustes y *.dominio-raíz, y los subdominios generados de los servicios se
# sirven con él en lugar de pedir uno cada uno (Let's Encrypt admite 50
# certificados nuevos por dominio registrado cada 7 días). Los dominios propios
# siguen con su propio certificado. Vacío, todo funciona como siempre.
#  - Crea un token en Cloudflare (Mi perfil → Tokens de API) con los permisos
#    «Zone · DNS · Edit» y «Zone · Zone · Read» y, en «Zone Resources», solo la
#    zona del dominio raíz. Es distinto del token de Ajustes → Cloudflare y solo
#    lo usa Traefik. No uses la clave global de la cuenta.
#  - Tras definirlo: docker compose up -d traefik. Después, marca «Certificado
#    comodín para el dominio raíz» en Ajustes → Dominios y TLS.
# En lugar de aquí, el token se puede guardar en Ajustes → Dominios y TLS, sin
# entrar en el servidor: Skyway lo deja en un volumen que solo lee Traefik. Si
# están los dos, manda este.
# Es un secreto: este .env no se sube al repositorio y conviene que solo lo
# lea root (chmod 600 .env).
CF_DNS_API_TOKEN=
